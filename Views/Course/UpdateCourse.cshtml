@model Sarah10415_MVC.Models.Course

    @{
        ViewBag.Title = "Edit Course";
    }

    <h2>Edit Course</h2>

    @using (Html.BeginForm("UpdateCourse", "Course", FormMethod.Post))
    {
        @Html.HiddenFor(model => model.courseID)

        <div class="form-group">
            @Html.LabelFor(model => model.courseName)
            @Html.TextBoxFor(model => model.courseName, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.isAvailable)
            @Html.CheckBoxFor(model => model.isAvailable)
        </div>

        <button type="submit" class="btn btn-primary">Update</button>
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
    }

